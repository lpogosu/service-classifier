# Ключ OpenRouter. Без него сервис работает в offline-режиме:
# детекция и решение о разделении считаются как обычно, LLM-верификация
# ничего не отбрасывает, черновики собираются по шаблону.
OPENROUTER_API_KEY=

# Модель для контекстной верификации (стадия 1.5).
VERIFICATION_MODEL=qwen/qwen3-235b-a22b-2507

# Модель для генерации черновиков (стадия 3).
DRAFT_MODEL=google/gemini-2.0-flash-001

# Пути к артефактам.
KEYPHRASES_PATH=data/key_phrases.csv
SPLIT_MODEL_PATH=models/split_classifier.pkl

# Поведение клиента LLM.
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=2
DRAFT_CONCURRENCY=10

LOG_LEVEL=INFO
